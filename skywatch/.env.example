# Copy to .env for local use. On Vercel, add these under Project → Settings → Environment Variables.
# Leave a key empty and that feed shows demo data.

# Windy Point Forecast API key — https://api.windy.com/keys
WINDY_API_KEY=

# Flightradar24 API token (paid subscription) — https://fr24api.flightradar24.com
FR24_API_KEY=

# Only used by scripts/ibkr-sync.mjs on your own computer.
IBKR_GATEWAY_URL=https://localhost:5000/v1/api
